# Porte Grok dans un conteneur isolé (spec 2026-11-12-porte-sanroque) : coffre
# Publication seulement ; plus de wiki ni d'accès à Ollama depuis le 2026-11-25.
# Refuse de démarrer sans le pare-feu (témoin de porte-pare-feu.service).
# --dns 192.0.2.1 (TEST-NET, non routé) : le résolveur intégré de Docker
# interroge depuis l'hôte, hors pare-feu ; sans résolveur amont, pas de canal DNS.
#
# ~/.config/porte-grok/conteneur.env (chmod 600 ; jamais porte.env, que
# l'installateur réécrit) :
#   PORTE_HOTE=0.0.0.0
#   PORTE_COFFRE=/coffre
#   PORTE_AGENTS=/etc/porte/agents
#   PYTHONDONTWRITEBYTECODE=1
[Unit]
Description=Porte Grok en conteneur (coffre Publication, 127.0.0.1:5052, Funnel 10000)
Conflicts=porte-grok.service

[Service]
Type=simple
ExecStartPre=/usr/local/sbin/porte-pare-feu.sh verifier
ExecStartPre=-/usr/bin/docker network create -o com.docker.network.bridge.name=br-porte porte-grok
ExecStartPre=-/usr/bin/docker rm -f porte-grok
ExecStart=/usr/bin/docker run --rm --name porte-grok \
  --network porte-grok -p 127.0.0.1:5052:5052 \
  --dns 192.0.2.1 \
  --user 1000:1000 --read-only --tmpfs /tmp \
  --cap-drop ALL --security-opt no-new-privileges \
  --env-file %h/.config/porte-grok/conteneur.env \
  -e HOME=/tmp \
  -e VENV=%h/Secretarius/Wiki_LM/.venv -e PORTE_DIR=%h/Secretarius/Wiki_LM/porte \
  -v %h/Documents/Publication:/coffre \
  -v %h/Secretarius/Wiki_LM/porte:%h/Secretarius/Wiki_LM/porte:ro \
  -v %h/Secretarius/Wiki_LM/.venv:%h/Secretarius/Wiki_LM/.venv:ro \
  -v %h/.config/porte-grok/agents:/etc/porte/agents:ro \
  porte-grok:local
ExecStop=/usr/bin/docker stop porte-grok
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
