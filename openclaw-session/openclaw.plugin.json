{
  "id": "session",
  "channels": ["session"],
  "name": "Session",
  "description": "Canal Session Messenger par le broker local de Secretarius",
  "version": "0.1.0",
  "configSchema": { "type": "object", "additionalProperties": false, "properties": {} },
  "channelConfigs": {
    "session": {
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean" },
          "brokerUrl": { "type": "string" },
          "dmPolicy": { "type": "string", "enum": ["allowlist"] },
          "allowFrom": { "type": "array", "items": { "type": "string", "pattern": "^05[0-9a-f]{64}$" } }
        }
      }
    }
  }
}
